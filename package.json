{
  "name": "solshield-protocol",
  "version": "1.0.0",
  "private": false,
  "description": "Non-custodial Solana transaction firewall, Blinks inspector, and Anchor policy vault powered by Venice AI.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "ext:typecheck": "tsc -p extension/tsconfig.json --noEmit",
    "ext:build": "node extension/scripts/build.mjs",
    "ext:test-dapp": "node extension/scripts/serve-test-dapp.mjs",
    "bot:check": "tsx worker/solshield-bot.ts --check",
    "bot:start": "tsx worker/solshield-bot.ts",
    "cdp:start": "tsx worker/cdp-server.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "ogl": "^1.0.11",
    "puppeteer-core": "^25.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
