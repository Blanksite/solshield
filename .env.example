# ==============================================================================
# SolShield® + BuildCheck Environment Configuration
# Copy to `.env.local` (Next.js local/Vercel) or `.env` (VPS Worker)
# ==============================================================================

# --- AI & Chain Forensics (Phase 1 & Phase 2) ---
# Venice AI Zero Data Retention API Key (https://venice.ai/settings/api)
# Enables qwen3-vl-235b-a22b UI Vision audit + llama-3.3-70b Proof Verdict.
# Optional in local dev (falls back to deterministic engine; UI also supports BYOK).
VENICE_API_KEY=

# Solana Mainnet RPC URL (default uses public RPC; Helius/QuickNode recommended in prod)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Override for Deployed Anchor SecurityPolicy Program ID (Mainnet / Devnet)
# Defaults to ByiifxwsDxRwMDiZU7TYceFsxT9XawGqffS5oTocwHE4
SOLSHIELD_PROGRAM_ID=
NEXT_PUBLIC_SOLSHIELD_PROGRAM_ID=

# Optional Canonical Protocol Policy Owner Pubkey (when no user wallet is connected)
# Defaults to the Devnet program deployer/authority 9MyE2b4xjrhbfFMvypZqqPnBfx3XVp6KeATkZk3xHzLD
SOLSHIELD_DEFAULT_POLICY_OWNER=
NEXT_PUBLIC_SOLSHIELD_DEFAULT_POLICY_OWNER=

# Optional GitHub Personal Access Token (raises GitHub API limit from 60/hr -> 5,000/hr)
GITHUB_TOKEN=

# --- API Abuse Guard & Shared Scan Cache ---
# Secret key for CLI / X bot / trusted automation (`x-solshield-api-key` or Bearer)
SOLSHIELD_API_SECRET=
# Optional Upstash Redis REST credentials (free tier enables $0 real-time scanned token sync across X bot & Vercel/Railway)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set "true" to also sync token scans from `npm run bot:start` / `bot:check` to ${NEXT_PUBLIC_APP_URL}/api/scanned-tokens using SOLSHIELD_API_SECRET
BOT_SYNC_TO_WEB=false
# Set "true" to block web-session demo access and require SOLSHIELD_API_SECRET or BYOK everywhere
SOLSHIELD_REQUIRE_API_KEY=false
# Global daily limit for server-funded fresh scans across all visitors (BYOK/API key bypasses)
SOLSHIELD_DAILY_SERVER_SCANS=250
# Optional comma-separated Chrome Extension IDs allowed on extension-hybrid routes (empty = any 32-char extension ID)
SOLSHIELD_ALLOWED_EXTENSION_IDS=
# Shared BuildCheck result cache TTL in ms (default 30 min = 1800000)
BUILDCHECK_CACHE_TTL_MS=1800000
# Max simultaneous headless Chromium instances (protects 512MB container memory)
BUILDCHECK_MAX_CONCURRENT_BROWSERS=2

# --- Token & Brand Display ---
NEXT_PUBLIC_TOKEN_CA=CMYb1BRKQyJBVRkrFdATB14PM62JbULzHsgbozGs2Sqx
NEXT_PUBLIC_TOKEN_SYMBOL=$SHIELD
NEXT_PUBLIC_X_URL=https://x.com/usesolshield
NEXT_PUBLIC_APP_URL=https://sol-shield.xyz

# --- Headless Chromium / Remote Browser CDP ---
# For Vercel production: point to your VPS CDP proxy (e.g. wss://cdp.sol-shield.xyz?token=YOUR_CDP_TOKEN)
# Leave blank locally to auto-detect Chrome / Edge / Playwright Chromium on this machine.
BUILDCHECK_BROWSER_WS_ENDPOINT=
BUILDCHECK_CHROME_PATH=

# VPS CDP Server (`npm run cdp:start`)
CDP_HOST=127.0.0.1
CDP_PORT=3001
CDP_AUTH_TOKEN=

# --- Phase 2: @usesolshield X Bot (`npm run bot:start`) ---
BOT_X_HANDLE=usesolshield
# Safety lock: keep "true" while testing locally (renders PNG cards in worker/out without posting).
# Switch to "false" ONLY when ready to post live replies on X.
BOT_DRY_RUN=true
BOT_POLL_INTERVAL_MS=60000
BOT_STATE_FILE=worker/data/bot-state.json
# Ignore historical mentions older than N minutes on startup/poll (0 = disabled)
BOT_MAX_MENTION_AGE_MINUTES=30
# Per-user cooldown between mentions in milliseconds
BOT_AUTHOR_COOLDOWN_MS=90000
# Daily live reply circuit breaker (UTC day, 0 = unlimited)
BOT_MAX_REPLIES_PER_DAY=40
# Set "false" to omit URL links from tweet body (keeps X Pay-Per-Use reply cost low; URL remains on PNG card)
BOT_INCLUDE_REPLY_URL=true
# Optional HTTP /health port (Railway healthcheck automatically binds PORT if set)
BOT_HEALTH_PORT=

# X Developer Portal Credentials (App with Read and Write permissions)
X_BEARER_TOKEN=
X_OAUTH2_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
