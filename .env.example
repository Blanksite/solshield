# Optional: Server-side Venice AI API key (get yours at https://venice.ai/settings/api)
# Users can also input their own Venice API Key directly in the web UI (BYOK via sessionStorage).
VENICE_API_KEY=

# Optional: Token launch Contract Address (leave blank pre-launch; set once minted to publish CA on the site)
NEXT_PUBLIC_TOKEN_CA=
NEXT_PUBLIC_TOKEN_SYMBOL=$SOLSHIELD
NEXT_PUBLIC_X_URL=https://x.com/usesolshield
